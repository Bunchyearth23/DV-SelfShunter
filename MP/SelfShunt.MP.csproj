<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SelfShunt.MP</AssemblyName>
    <RootNamespace>SelfShunt.MP</RootNamespace>
    <GameDir Condition="'$(GameDir)' == ''">D:\Steam\steamapps\common\Derail Valley</GameDir>
    <MultiplayerApiPath Condition="'$(MultiplayerApiPath)' == ''">$(MSBuildProjectDirectory)\..\..\dv-multiplayer-beta\MultiplayerAPI\bin\Release\net48\MultiplayerAPI.dll</MultiplayerApiPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SS\SelfShunt.csproj" />
    <Reference Include="MultiplayerAPI" HintPath="$(MultiplayerApiPath)" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameDir)\DerailValley_Data\Managed\Assembly-CSharp.dll" Private="false" />
    <Reference Include="DV.ThingTypes" HintPath="$(GameDir)\DerailValley_Data\Managed\DV.ThingTypes.dll" Private="false" />
    <Reference Include="DV.Utils" HintPath="$(GameDir)\DerailValley_Data\Managed\DV.Utils.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDir)\DerailValley_Data\Managed\UnityModManager\0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameDir)\DerailValley_Data\Managed\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityModManager" HintPath="$(GameDir)\DerailValley_Data\Managed\UnityModManager\UnityModManager.dll" Private="false" />
  </ItemGroup>
</Project>
